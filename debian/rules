#!/usr/bin/make -f
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
UNREGISTRY_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/[-~].*//')
# unregistry is not published as a release binary, so it is built from the tag
# being packaged; Go cross-compiles, so GOARCH is the only difference between
# architectures.
GOARCH := $(DEB_HOST_ARCH)

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	@case "$(DEB_HOST_ARCH)" in \
		amd64|arm64) ;; \
		*) echo "Unsupported architecture: $(DEB_HOST_ARCH)"; exit 1 ;; \
	esac
	git clone --depth 1 --branch "v$(UNREGISTRY_VERSION)" https://github.com/psviderski/unregistry.git unregistry-src
	cd unregistry-src && CGO_ENABLED=0 GOOS=linux GOARCH=$(GOARCH) go build -o unregistry ./cmd/unregistry
	wget -q "https://raw.githubusercontent.com/psviderski/unregistry/v$(UNREGISTRY_VERSION)/docker-pussh" -O docker-pussh
	chmod +x docker-pussh

override_dh_auto_install:
	install -D -m 755 unregistry-src/unregistry debian/unregistry/usr/local/bin/unregistry
	install -D -m 755 docker-pussh debian/docker-pussh/usr/local/bin/docker-pussh

override_dh_auto_test:

override_dh_auto_clean:
	rm -rf unregistry-src docker-pussh

override_dh_strip:

override_dh_shlibdeps:
